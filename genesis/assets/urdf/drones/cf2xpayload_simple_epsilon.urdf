<?xml version="1.0" encoding="utf-8"?>
<robot name="cf2">

  <!-- Drone morph 推进参数 -->
  <properties arm="0.0397" kf="3.16e-10" km="7.94e-12"
              thrust2weight="2.25" max_speed_kmh="30"
              gnd_eff_coeff="11.36859" prop_radius="0.0231348"
              drag_coeff_xy="9.1785e-7" drag_coeff_z="1.0311e-6"
              dw_coeff_1="2267.18" dw_coeff_2="0.16" dw_coeff_3="-0.11"/>

  <!-- 机体 -->
  <link name="base_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.027"/>
      <inertia ixx="1.4e-5" ixy="0" ixz="0" iyy="1.4e-5" iyz="0" izz="2.17e-5"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="./body.obj" scale="1 1 1"/></geometry>
      <material name="grey"><color rgba="0.5 0.5 0.5 1"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><cylinder radius="0.06" length="0.025"/></geometry>
    </collision>
  </link>

  <!-- 四个桨（保持 fixed，用于推进与渲染定位） -->
  <link name="prop0_link">
    <inertial><origin xyz="0.028 -0.028 0" rpy="0 0 0"/><mass value="0"/>
      <inertia ixx="0" ixy="0" ixz="0" iyy="0" iyz="0" izz="0"/></inertial>
    <visual>
      <origin xyz="0.0323 -0.0323 0.0132" rpy="0 0 0"/>
      <geometry><mesh filename="./propeller0.obj"/></geometry>
    </visual>
  </link>
  <joint name="prop0_joint" type="fixed">
    <parent link="base_link"/><child link="prop0_link"/>
  </joint>

  <link name="prop1_link">
    <inertial><origin xyz="-0.028 -0.028 0" rpy="0 0 0"/><mass value="0"/>
      <inertia ixx="0" ixy="0" ixz="0" iyy="0" iyz="0" izz="0"/></inertial>
    <visual>
      <origin xyz="-0.0323 -0.0323 0.0132" rpy="0 0 0"/>
      <geometry><mesh filename="./propeller1.obj"/></geometry>
    </visual>
  </link>
  <joint name="prop1_joint" type="fixed">
    <parent link="base_link"/><child link="prop1_link"/>
  </joint>

  <link name="prop2_link">
    <inertial><origin xyz="-0.028 0.028 0" rpy="0 0 0"/><mass value="0"/>
      <inertia ixx="0" ixy="0" ixz="0" iyy="0" iyz="0" izz="0"/></inertial>
    <visual>
      <origin xyz="-0.0323 0.0323 0.0132" rpy="0 0 0"/>
      <geometry><mesh filename="./propeller2.obj"/></geometry>
    </visual>
  </link>
  <joint name="prop2_joint" type="fixed">
    <parent link="base_link"/><child link="prop2_link"/>
  </joint>

  <link name="prop3_link">
    <inertial><origin xyz="0.028 0.028 0" rpy="0 0 0"/><mass value="0"/>
      <inertia ixx="0" ixy="0" ixz="0" iyy="0" iyz="0" izz="0"/></inertial>
    <visual>
      <origin xyz="0.0323 0.0323 0.0132" rpy="0 0 0"/>
      <geometry><mesh filename="./propeller3.obj"/></geometry>
    </visual>
  </link>
  <joint name="prop3_joint" type="fixed">
    <parent link="base_link"/><child link="prop3_link"/>
  </joint>

  <link name="center_of_mass_link">
    <inertial><origin xyz="0 0 0" rpy="0 0 0"/><mass value="0"/>
      <inertia ixx="0" ixy="0" ixz="0" iyy="0" iyz="0" izz="0"/></inertial>
  </link>
  <joint name="center_of_mass_joint" type="fixed">
    <parent link="base_link"/><child link="center_of_mass_link"/>
  </joint>

  <!-- ========== 简化版：单段定长刚性杆吊索系统 ========== -->
  
  <!-- 绳索连接点（从无人机底部开始） -->
  <link name="rope_attachment">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="1e-6"/>
      <inertia ixx="1e-9" ixy="0" ixz="0" iyy="1e-9" iyz="0" izz="1e-9"/>
    </inertial>
  </link>
  <joint name="rope_attachment_joint" type="fixed">
    <parent link="base_link"/>
    <child link="rope_attachment"/>
    <origin xyz="0 0 -0.05" rpy="0 0 0"/>
  </joint>

  <!-- 万向节：X轴旋转 -->
  <link name="gimbal_x">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="5e-4"/>
      <inertia ixx="1e-07" ixy="0" ixz="0" iyy="1e-07" iyz="0" izz="1e-07"/>
    </inertial>
  </link>
  <joint name="gimbal_x_joint" type="continuous">
    <parent link="rope_attachment"/>
    <child link="gimbal_x"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="-3.1416" upper="3.1416" effort="0.1" velocity="10"/>
    <dynamics damping="0.08"/>
  </joint>

  <!-- 万向节：Y轴旋转 -->
  <link name="gimbal_y">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="5e-4"/>
      <inertia ixx="1e-07" ixy="0" ixz="0" iyy="1e-07" iyz="0" izz="1e-07"/>
    </inertial>
  </link>
  <joint name="gimbal_y_joint" type="continuous">
    <parent link="gimbal_x"/>
    <child link="gimbal_y"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-3.1416" upper="3.1416" effort="0.1" velocity="10"/>
    <dynamics damping="0.08"/>
  </joint>

  <!-- 单段定长刚性杆（1.0米长） -->
  <link name="rigid_rod">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="1e-6"/>
      <inertia ixx="8.333e-08" ixy="0" ixz="0" iyy="8.333e-08" iyz="0" izz="4.5e-12"/>
    </inertial>
    <visual>
      <origin xyz=" 0 0 -0.5" rpy="0 0 0"/>
      <geometry><cylinder length=" 1.0" radius="0.003"/></geometry>
      <material name="rope_dark"><color rgba="0.1 0.1 0.1 1"/></material>
    </visual>
    <!-- 无碰撞检测 -->
  </link>
  <joint name="rigid_rod_joint" type="fixed">
    <parent link="gimbal_y"/>
    <child link="rigid_rod"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- 载荷连接万向节：X轴旋转 -->
  <link name="payload_gimbal_x">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="5e-4"/>
      <inertia ixx="1e-07" ixy="0" ixz="0" iyy="1e-07" iyz="0" izz="1e-07"/>
    </inertial>
  </link>
  <joint name="payload_gimbal_x_joint" type="continuous">
    <parent link="rigid_rod"/>
    <child link="payload_gimbal_x"/>
    <origin xyz="0 0 -1.0" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="-3.1416" upper="3.1416" effort="0.05" velocity="20"/>
    <dynamics damping="0.08"/>
  </joint>

  <!-- 载荷连接万向节：Y轴旋转 -->
  <link name="payload_gimbal_y">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="5e-4"/>
      <inertia ixx="1e-07" ixy="0" ixz="0" iyy="1e-07" iyz="0" izz="1e-07"/>
    </inertial>
  </link>
  <joint name="payload_gimbal_y_joint" type="continuous">
    <parent link="payload_gimbal_x"/>
    <child link="payload_gimbal_y"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-3.1416" upper="3.1416" effort="0.05" velocity="20"/>
    <dynamics damping="0.08"/>
  </joint>

  <!-- 小球载荷 -->
  <link name="payload_ball">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.02"/>
      <inertia ixx="5e-06" ixy="0" ixz="0" iyy="5e-06" iyz="0" izz="5e-06"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><sphere radius="0.025"/></geometry>
      <material name="ball_red"><color rgba="0.9 0.1 0.1 1"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><sphere radius="0.025"/></geometry>
    </collision>
  </link>

  <!-- 载荷连接关节 -->
  <joint name="payload_joint" type="continuous">
    <parent link="payload_gimbal_y"/>
    <child link="payload_ball"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.1416" upper="3.1416" effort="0.05" velocity="20"/>
    <dynamics damping="0.08"/>
  </joint>

</robot>
