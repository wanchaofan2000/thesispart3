<?xml version="1.0" encoding="utf-8"?>
<robot name="cf2">

  <!-- Drone morph 推进参数 -->
  <properties arm="0.0397" kf="3.16e-10" km="7.94e-12"
              thrust2weight="2.25" max_speed_kmh="30"
              gnd_eff_coeff="11.36859" prop_radius="0.0231348"
              drag_coeff_xy="9.1785e-7" drag_coeff_z="1.0311e-6"
              dw_coeff_1="2267.18" dw_coeff_2="0.16" dw_coeff_3="-0.11"/>

  <!-- 机体 -->
  <link name="base_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.027"/>
      <inertia ixx="1.4e-5" ixy="0" ixz="0" iyy="1.4e-5" iyz="0" izz="2.17e-5"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="./body.obj" scale="1 1 1"/></geometry>
      <material name="grey"><color rgba="0.5 0.5 0.5 1"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><cylinder radius="0.06" length="0.025"/></geometry>
    </collision>
  </link>

  <!-- 四个桨（保持 fixed，用于推进与渲染定位） -->
  <link name="prop0_link">
    <inertial><origin xyz="0.028 -0.028 0" rpy="0 0 0"/><mass value="0"/>
      <inertia ixx="0" ixy="0" ixz="0" iyy="0" iyz="0" izz="0"/></inertial>
    <visual>
      <origin xyz="0.0323 -0.0323 0.0132" rpy="0 0 0"/>
      <geometry><mesh filename="./propeller0.obj"/></geometry>
    </visual>
  </link>
  <joint name="prop0_joint" type="fixed">
    <parent link="base_link"/><child link="prop0_link"/>
  </joint>

  <link name="prop1_link">
    <inertial><origin xyz="-0.028 -0.028 0" rpy="0 0 0"/><mass value="0"/>
      <inertia ixx="0" ixy="0" ixz="0" iyy="0" iyz="0" izz="0"/></inertial>
    <visual>
      <origin xyz="-0.0323 -0.0323 0.0132" rpy="0 0 0"/>
      <geometry><mesh filename="./propeller1.obj"/></geometry>
    </visual>
  </link>
  <joint name="prop1_joint" type="fixed">
    <parent link="base_link"/><child link="prop1_link"/>
  </joint>

  <link name="prop2_link">
    <inertial><origin xyz="-0.028 0.028 0" rpy="0 0 0"/><mass value="0"/>
      <inertia ixx="0" ixy="0" ixz="0" iyy="0" iyz="0" izz="0"/></inertial>
    <visual>
      <origin xyz="-0.0323 0.0323 0.0132" rpy="0 0 0"/>
      <geometry><mesh filename="./propeller2.obj"/></geometry>
    </visual>
  </link>
  <joint name="prop2_joint" type="fixed">
    <parent link="base_link"/><child link="prop2_link"/>
  </joint>

  <link name="prop3_link">
    <inertial><origin xyz="0.028 0.028 0" rpy="0 0 0"/><mass value="0"/>
      <inertia ixx="0" ixy="0" ixz="0" iyy="0" iyz="0" izz="0"/></inertial>
    <visual>
      <origin xyz="0.0323 0.0323 0.0132" rpy="0 0 0"/>
      <geometry><mesh filename="./propeller3.obj"/></geometry>
    </visual>
  </link>
  <joint name="prop3_joint" type="fixed">
    <parent link="base_link"/><child link="prop3_link"/>
  </joint>

  <link name="center_of_mass_link">
    <inertial><origin xyz="0 0 0" rpy="0 0 0"/><mass value="0"/>
      <inertia ixx="0" ixy="0" ixz="0" iyy="0" iyz="0" izz="0"/></inertial>
  </link>
  <joint name="center_of_mass_joint" type="fixed">
    <parent link="base_link"/><child link="center_of_mass_link"/>
  </joint>

  <!-- ========== 新增：柔性吊索系统（合理质量、阻尼、2-DoF万向节） ========== -->
  
  <!-- 绳索连接点（从无人机底部开始） -->
  <link name="rope_attachment">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="1e-6"/>
      <inertia ixx="1e-9" ixy="0" ixz="0" iyy="1e-9" iyz="0" izz="1e-9"/>
    </inertial>
  </link>
  <joint name="rope_attachment_joint" type="fixed">
    <parent link="base_link"/>
    <child link="rope_attachment"/>
    <origin xyz="0 0 -0.05" rpy="0 0 0"/>
  </joint>

  <!-- 第1个万向节：X轴旋转 -->
  <link name="gimbal_1_x">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="1e-6"/>
      <inertia ixx="1e-9" ixy="0" ixz="0" iyy="1e-9" iyz="0" izz="1e-9"/>
    </inertial>
  </link>
  <joint name="gimbal_1_x_joint" type="revolute">
    <parent link="rope_attachment"/>
    <child link="gimbal_1_x"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="-3.1416" upper="3.1416" effort="0.1" velocity="10"/>
    <dynamics damping="0.01" friction="0.001"/>
  </joint>

  <!-- 第1个万向节：Y轴旋转 -->
  <link name="gimbal_1_y">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="1e-6"/>
      <inertia ixx="1e-9" ixy="0" ixz="0" iyy="1e-9" iyz="0" izz="1e-9"/>
    </inertial>
  </link>
  <joint name="gimbal_1_y_joint" type="revolute">
    <parent link="gimbal_1_x"/>
    <child link="gimbal_1_y"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-3.1416" upper="3.1416" effort="0.1" velocity="10"/>
    <dynamics damping="0.01" friction="0.001"/>
  </joint>

  <!-- 第1段绳索（合理质量、无碰撞，仅视觉） -->
  <link name="rope_segment_1">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.0005"/>
      <inertia ixx="1e-8" ixy="0" ixz="0" iyy="1e-8" iyz="0" izz="1e-8"/>
