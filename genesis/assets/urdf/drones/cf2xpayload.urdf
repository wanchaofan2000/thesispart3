    <visual>
      <origin xyz="0 0 -0.05" rpy="0 0 0"/>
      <geometry><cylinder length="0.10" radius="0.003"/></geometry>
      <material name="rope_dark"><color rgba="0.1 0.1 0.1 1"/></material>
    </visual>
    <!-- 无碰撞检测 -->
  </link>
  <joint name="rope_segment_1_joint" type="fixed">
    <parent link="gimbal_1_y"/>
    <child link="rope_segment_1"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

