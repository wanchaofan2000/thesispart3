      <origin xyz="0 0 -0.05" rpy="0 0 0"/>
      <geometry><cylinder length="0.10" radius="0.003"/></geometry>
      <material name="rope_dark"><color rgba="0.1 0.1 0.1 1"/></material>
    </visual>
  </link>
  <joint name="rope_segment_8_joint" type="fixed">
    <parent link="gimbal_8_y"/>
    <child link="rope_segment_8"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- 第9个万向节：X轴旋转 -->
  <link name="gimbal_9_x">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="1e-6"/>
      <inertia ixx="1e-9" ixy="0" ixz="0" iyy="1e-9" iyz="0" izz="1e-9"/>
    </inertial>
  </link>
  <joint name="gimbal_9_x_joint" type="revolute">
    <parent link="rope_segment_8"/>
    <child link="gimbal_9_x"/>
    <origin xyz="0 0 -0.10" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="-3.1416" upper="3.1416" effort="0.1" velocity="10"/>
    <dynamics damping="0.01" friction="0.001"/>
  </joint>

  <!-- 第9个万向节：Y轴旋转 -->
  <link name="gimbal_9_y">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="1e-6"/>
      <inertia ixx="1e-9" ixy="0" ixz="0" iyy="1e-9" iyz="0" izz="1e-9"/>
    </inertial>
  </link>
  <joint name="gimbal_9_y_joint" type="revolute">
    <parent link="gimbal_9_x"/>
    <child link="gimbal_9_y"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-3.1416" upper="3.1416" effort="0.1" velocity="10"/>
    <dynamics damping="0.01" friction="0.001"/>
  </joint>

  <!-- 第9段绳索 -->
  <link name="rope_segment_9">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.0005"/>
      <inertia ixx="1e-8" ixy="0" ixz="0" iyy="1e-8" iyz="0" izz="1e-8"/>
    </inertial>
    <visual>
      <origin xyz="0 0 -0.05" rpy="0 0 0"/>
      <geometry><cylinder length="0.10" radius="0.003"/></geometry>
      <material name="rope_dark"><color rgba="0.1 0.1 0.1 1"/></material>
    </visual>
  </link>
  <joint name="rope_segment_9_joint" type="fixed">
    <parent link="gimbal_9_y"/>
    <child link="rope_segment_9"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- 第10个万向节：X轴旋转 -->
  <link name="gimbal_10_x">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="1e-6"/>
      <inertia ixx="1e-9" ixy="0" ixz="0" iyy="1e-9" iyz="0" izz="1e-9"/>
    </inertial>
  </link>
  <joint name="gimbal_10_x_joint" type="revolute">
    <parent link="rope_segment_9"/>
    <child link="gimbal_10_x"/>
    <origin xyz="0 0 -0.10" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="-3.1416" upper="3.1416" effort="0.1" velocity="10"/>
    <dynamics damping="0.01" friction="0.001"/>
  </joint>

  <!-- 第10个万向节：Y轴旋转 -->
  <link name="gimbal_10_y">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="1e-6"/>
      <inertia ixx="1e-9" ixy="0" ixz="0" iyy="1e-9" iyz="0" izz="1e-9"/>
    </inertial>
  </link>
  <joint name="gimbal_10_y_joint" type="revolute">
    <parent link="gimbal_10_x"/>
    <child link="gimbal_10_y"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-3.1416" upper="3.1416" effort="0.1" velocity="10"/>
    <dynamics damping="0.01" friction="0.001"/>
  </joint>

  <!-- 第10段绳索 -->
  <link name="rope_segment_10">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.0005"/>
      <inertia ixx="1e-8" ixy="0" ixz="0" iyy="1e-8" iyz="0" izz="1e-8"/>
    </inertial>
    <visual>
      <origin xyz="0 0 -0.05" rpy="0 0 0"/>
      <geometry><cylinder length="0.10" radius="0.003"/></geometry>
      <material name="rope_dark"><color rgba="0.1 0.1 0.1 1"/></material>
    </visual>
  </link>
  <joint name="rope_segment_10_joint" type="fixed">
    <parent link="gimbal_10_y"/>
    <child link="rope_segment_10"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- 载荷连接万向节：X轴旋转 -->
  <link name="payload_gimbal_x">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="1e-6"/>
      <inertia ixx="1e-9" ixy="0" ixz="0" iyy="1e-9" iyz="0" izz="1e-9"/>
    </inertial>
  </link>
  <joint name="payload_gimbal_x_joint" type="revolute">
    <parent link="rope_segment_10"/>
    <child link="payload_gimbal_x"/>
    <origin xyz="0 0 -0.10" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="-3.1416" upper="3.1416" effort="0.05" velocity="20"/>
    <dynamics damping="0.01" friction="0.001"/>
  </joint>

  <!-- 载荷连接万向节：Y轴旋转 -->
  <link name="payload_gimbal_y">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="1e-6"/>
      <inertia ixx="1e-9" ixy="0" ixz="0" iyy="1e-9" iyz="0" izz="1e-9"/>
    </inertial>
  </link>
  <joint name="payload_gimbal_y_joint" type="revolute">
    <parent link="payload_gimbal_x"/>
    <child link="payload_gimbal_y"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-3.1416" upper="3.1416" effort="0.05" velocity="20"/>
    <dynamics damping="0.01" friction="0.001"/>
  </joint>

  <!-- 小球载荷 -->
  <link name="payload_ball">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.005"/>
      <!-- 球惯量：I = 2/5 m r^2（r=0.025 m） -->
      <inertia ixx="1.25e-09" ixy="0" ixz="0"
               iyy="1.25e-09" iyz="0" izz="1.25e-09"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><sphere radius="0.025"/></geometry>
      <material name="ball_red"><color rgba="0.9 0.1 0.1 1"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><sphere radius="0.025"/></geometry>
    </collision>
  </link>

  <!-- 载荷连接关节 -->
  <joint name="payload_joint" type="revolute">
    <parent link="payload_gimbal_y"/>
    <child link="payload_ball"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.1416" upper="3.1416" effort="0.05" velocity="20"/>
    <dynamics damping="0.01" friction="0.001"/>
  </joint>

</robot>
